// Mô hình dữ liệu lõi — chốt ở context/ARCHITECTURE.md §6 (pha V, đường intake).
// Vòng 1 chỉ dùng một phần các trường/thực thể — xem context/CAPABILITIES-MAP.md §2
// và context/DECISIONS.md (2026-09-10, "schema Prisma dựng đủ 5 thực thể ngay ở vòng 1").

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: URL kết nối không còn khai ở đây — chuyển sang prisma.config.ts (CLI/migrate)
// và driver adapter truyền vào PrismaClient (runtime). Xem src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  worker
  bat_coordinator
}

enum Line {
  may_va
  bat
}

enum TaskStatus {
  new
  acked
  in_progress
  done
}

enum TaskSource {
  voice
  manual
}

enum TaskEventKind {
  acked
  started
  done
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      Role
  line      Line?
  active    Boolean  @default(true)
  email     String?  @unique // chỉ owner dùng — email/mật khẩu (PRD.md §7)
  password  String? // hash bcrypt — chỉ owner
  // Review pha P vòng 6 (SECURITY.md §3 "đăng xuất được"): token owner không có
  // pairingId nên JwtAuthGuard bỏ qua kiểm thu hồi — bump field này (qua
  // POST /auth/logout-everywhere) là cách duy nhất vô hiệu hoá token owner cũ mà
  // không phải đổi JWT_SECRET (kéo theo đăng xuất toàn bộ công nhân/điều phối).
  tokenVersion Int @default(0) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devicePairings  DevicePairing[]
  assignments     TaskAssignee[]
  createdTasks    Task[]          @relation("TaskCreatedBy")
  assignedByTasks TaskAssignee[]  @relation("AssignedBy")
  taskEvents      TaskEvent[]
  feedback        Feedback[]

  @@map("users")
}

model Task {
  id           String     @id @default(uuid())
  content      String
  line         Line
  measurements String? // chỉ dùng cho line = bat (vòng 4)
  dueAt        DateTime?  @map("due_at")
  priority     Int        @default(0)
  status       TaskStatus @default(new)
  source       TaskSource @default(manual)
  createdById  String     @map("created_by")
  createdBy    User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  deletedAt    DateTime?  @map("deleted_at")
  // CAP-TASK-14 (vòng 6) — mốc lần cuối cùng gửi nhắc "chưa ack"/"sắp tới hạn", chặn spam
  // khi cron chạy lại trước hết cooldown (DECISIONS.md 2026-09-15).
  lastReminderAt DateTime? @map("last_reminder_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignees TaskAssignee[]
  events    TaskEvent[]

  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedById String @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task       Task @relation(fields: [taskId], references: [id])
  user       User @relation(fields: [userId], references: [id])
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])

  @@id([taskId, userId])
  @@map("task_assignees")
}

model DevicePairing {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  code        String    @unique // mã một lần, hết hạn 15 phút (PAIRING_CODE_TTL_MIN)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  deviceLabel String?   @map("device_label")
  deviceToken String?   @map("device_token") // Expo push token
  lastSeenAt  DateTime? @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("device_pairings")
}

model TaskEvent {
  id     String        @id @default(uuid())
  taskId String        @map("task_id")
  task   Task          @relation(fields: [taskId], references: [id])
  userId String        @map("user_id")
  user   User          @relation(fields: [userId], references: [id])
  kind   TaskEventKind
  at     DateTime      @default(now())

  @@unique([taskId, userId, kind])
  @@map("task_events")
}

// Nhóm 4 production-ready — "kênh feedback": người dùng phản hồi được ngay trong sản
// phẩm (review pha P vòng 6). Chưa có màn nào để owner ĐỌC lại danh sách này ở vòng 6 —
// đọc trực tiếp qua DB trong lúc pilot vòng 7 là đủ cho quy mô xưởng nhỏ; màn đọc riêng
// (nếu cần) là việc của vòng sau, không phải AC nào của vòng 6.
model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}
