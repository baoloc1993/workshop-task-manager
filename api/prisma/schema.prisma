// Mô hình dữ liệu lõi — chốt ở context/ARCHITECTURE.md §6 (pha V, đường intake).
// Vòng 1 chỉ dùng một phần các trường/thực thể — xem context/CAPABILITIES-MAP.md §2
// và context/DECISIONS.md (2026-09-10, "schema Prisma dựng đủ 5 thực thể ngay ở vòng 1").

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: URL kết nối không còn khai ở đây — chuyển sang prisma.config.ts (CLI/migrate)
// và driver adapter truyền vào PrismaClient (runtime). Xem src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  worker
  bat_coordinator
}

enum Line {
  may_va
  bat
  // vòng 7 — ARCHITECTURE.md §6 "Mở rộng mảng đệm ghế". Thêm giá trị enum là additive
  // (BACKWARD-COMPATIBILITY-CHECKLIST.md §2) — không đổi nghĩa hai giá trị cũ.
  dem
}

enum TaskStatus {
  new
  acked
  in_progress
  done
}

enum TaskSource {
  voice
  manual
  // vòng 9 — CAP-TASK-16 (AC-40): thợ/điều phối tự ghi việc cho chính mình. Thêm giá trị enum
  // là additive (BACKWARD-COMPATIBILITY-CHECKLIST.md §2).
  self
}

// vòng 9 — CAP-TASK-16 (AC-41, ARCHITECTURE.md §6 "Mở rộng vòng 9"). Mặc định `approved`
// để mọi việc cũ (chủ xưởng giao, đơn đệm) giữ nguyên nghĩa; `pending`/`rejected` chỉ xuất
// hiện khi source=self. Máy trạng thái: chỉ pending → approved|rejected, không lùi.
enum TaskApproval {
  approved
  pending
  rejected
}

enum TaskEventKind {
  acked
  started
  done
}

// vòng 7 — nhóm chuyên trách của mảng đệm (ARCHITECTURE.md §6 "User (mở rộng)").
// Một người có thể thuộc nhiều nhóm cùng lúc (User.groups là mảng).
enum WorkerGroup {
  do
  may
  cat_mut
  khau_lot
  nhoi
  theu
}

// vòng 7 — công đoạn của một Task khi line=dem (ARCHITECTURE.md §6 "Task (mở rộng)").
// tinh_cat KHÔNG sinh việc hàng-đợi-nhóm — nó là hành động của S24 (owner), gộp cả
// "tính cắt vải" lẫn "tính cắt mút" thành một Task duy nhất theo prototype S24.
enum TaskStep {
  do
  tinh_cat
  may_vai
  cat_mut
  khau_lot
  theu
  goi_tua
  nhoi
}

enum OrderMode {
  buon
  le
}

enum OrderDifficulty {
  de
  kho
}

enum OrderStatus {
  moi
  dang_lam
  cho_tra
  da_tra
}

enum DeliveryMethod {
  xe_om
  route
  self_pickup
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      Role
  line      Line?
  active    Boolean  @default(true)
  email     String?  @unique // chỉ owner dùng — email/mật khẩu (PRD.md §7)
  password  String? // hash bcrypt — chỉ owner
  // Review pha P vòng 6 (SECURITY.md §3 "đăng xuất được"): token owner không có
  // pairingId nên JwtAuthGuard bỏ qua kiểm thu hồi — bump field này (qua
  // POST /auth/logout-everywhere) là cách duy nhất vô hiệu hoá token owner cũ mà
  // không phải đổi JWT_SECRET (kéo theo đăng xuất toàn bộ công nhân/điều phối).
  tokenVersion Int @default(0) @map("token_version")
  // vòng 7 — ARCHITECTURE.md §6 "User (mở rộng)": chỉ có ý nghĩa khi line=dem. Mảng
  // rỗng = chưa được phân vào nhóm nào, không nhận được việc hàng-đợi-nhóm nào.
  groups    WorkerGroup[] @default([])
  // vòng 9 — CAP-TASK-16 (AC-41): việc người này tự ghi có vào thẳng danh sách không.
  // Mặc định TẮT (DECISIONS.md 2026-09-22) — chỉ có nghĩa với worker/bat_coordinator.
  autoApprove Boolean @default(false) @map("auto_approve")
  // vòng 9 — AC-41: owner đăng nhập bằng email, không có DevicePairing nên trước đây
  // không có chỗ lưu push token → "có việc chờ duyệt" không tới được máy chủ xưởng.
  // Chỉ owner dùng; thợ/điều phối vẫn giữ token trên DevicePairing như cũ.
  pushToken String? @map("push_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devicePairings  DevicePairing[]
  assignments     TaskAssignee[]
  createdTasks    Task[]          @relation("TaskCreatedBy")
  assignedByTasks TaskAssignee[]  @relation("AssignedBy")
  taskEvents      TaskEvent[]
  feedback        Feedback[]
  createdOrders   Order[]         @relation("OrderCreatedBy")

  @@map("users")
}

model Task {
  id           String     @id @default(uuid())
  content      String
  line         Line
  measurements String? // chỉ dùng cho line = bat (vòng 4)
  dueAt        DateTime?  @map("due_at")
  priority     Int        @default(0)
  status       TaskStatus @default(new)
  source       TaskSource @default(manual)
  // vòng 9 — CAP-TASK-16: danh sách toàn xưởng chỉ lấy `approved` (ARCHITECTURE.md §6).
  approval     TaskApproval @default(approved)
  createdById  String     @map("created_by")
  createdBy    User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  deletedAt    DateTime?  @map("deleted_at")
  // CAP-TASK-14 (vòng 6) — mốc lần cuối cùng gửi nhắc "chưa ack"/"sắp tới hạn", chặn spam
  // khi cron chạy lại trước hết cooldown (DECISIONS.md 2026-09-15).
  lastReminderAt DateTime? @map("last_reminder_at")
  // vòng 7 — ARCHITECTURE.md §6 "Task (mở rộng, chỉ khi line=dem)". orderId NULL nghĩa
  // là line != dem (may vá/bạt không đổi). Cả hai cột nullable — additive.
  orderId String?   @map("order_id")
  order   Order?    @relation(fields: [orderId], references: [id])
  step    TaskStep?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignees TaskAssignee[]
  events    TaskEvent[]

  // review pha P vòng 7: cutDone() và onDemTaskDone()
  // đọc-rồi-ghi ngoài transaction có khoá — hai request đồng thời (double-submit "Chốt số
  // cắt", hoặc hai Task chặng 2 cuối cùng "Xong" gần như cùng lúc) có thể sinh TRÙNG Task
  // cùng step cho cùng đơn (2 bộ chặng 2, hoặc 2 Task "nhồi"). Mỗi đơn chỉ có đúng MỘT Task
  // cho mỗi step theo thiết kế hiện tại (không có luồng tạo lại) — ràng buộc DB chặn đụng
  // độ thật, không chỉ dựa vào khoá UI. `orderId` NULL (mảng bạt/may vá) không bị ảnh hưởng.
  @@unique([orderId, step])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedById String @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task       Task @relation(fields: [taskId], references: [id])
  user       User @relation(fields: [userId], references: [id])
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])

  @@id([taskId, userId])
  @@map("task_assignees")
}

model DevicePairing {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  code        String    @unique // mã một lần, hết hạn 15 phút (PAIRING_CODE_TTL_MIN)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  deviceLabel String?   @map("device_label")
  deviceToken String?   @map("device_token") // Expo push token
  lastSeenAt  DateTime? @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("device_pairings")
}

model TaskEvent {
  id     String        @id @default(uuid())
  taskId String        @map("task_id")
  task   Task          @relation(fields: [taskId], references: [id])
  userId String        @map("user_id")
  user   User          @relation(fields: [userId], references: [id])
  kind   TaskEventKind
  at     DateTime      @default(now())

  @@unique([taskId, userId, kind])
  @@map("task_events")
}

// Nhóm 4 production-ready — "kênh feedback": người dùng phản hồi được ngay trong sản
// phẩm (review pha P vòng 6). Chưa có màn nào để owner ĐỌC lại danh sách này ở vòng 6 —
// đọc trực tiếp qua DB trong lúc pilot vòng 7 là đủ cho quy mô xưởng nhỏ; màn đọc riêng
// (nếu cần) là việc của vòng sau, không phải AC nào của vòng 6.
model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

// vòng 7 — ARCHITECTURE.md §6 "Mở rộng mảng đệm ghế". Khách hàng KHÔNG phải User —
// không tài khoản, không đăng nhập, không persona (DECISIONS.md 2026-09-14 qua chat).
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  // Khu vực trả lần trước — gợi ý cho đơn kế tiếp (tính ở client, DECISIONS.md 2026-09-18).
  areaId    String?  @map("area_id")
  area      Route?   @relation(fields: [areaId], references: [id])
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  // Không unique trên phone — "Trùng dữ liệu" giữ triết lý chung của app
  // (ARCHITECTURE.md §6: "không tự phát hiện/gộp, chủ xưởng tự chịu").
  @@index([phone])
  @@map("customers")
}

// vòng 7 — "khu vực" trả hàng (ARCHITECTURE.md §6). Danh sách phẳng chủ xưởng tự cấu
// hình (S25), 4-7 khu vực dự kiến. "Xe ôm chuyến lẻ"/"Khách tự lấy" KHÔNG phải Route —
// là giá trị cố định của Order.deliveryMethod.
model Route {
  id        String   @id @default(uuid())
  name      String
  landmarks String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers Customer[]
  orders    Order[]

  @@map("routes")
}

// vòng 7 — ARCHITECTURE.md §6. `remaining = price - deposit` tính ở tầng đọc, không lưu
// cột riêng. Đây là loại trừ công nợ DUY NHẤT được mở, chỉ cho line=dem (PRD.md §5).
model Order {
  id          String          @id @default(uuid())
  customerId  String          @map("customer_id")
  customer    Customer        @relation(fields: [customerId], references: [id])
  mode        OrderMode
  description String
  difficulty  OrderDifficulty @default(de)
  photos      String[]        @default([]) // data-URI base64 (DECISIONS.md 2026-09-18 — không có blob storage)

  // Số đo — nullable tới khi người đo điền xong (CAP-DEM-02). Tách 4 cột riêng (không
  // gộp text như Task.measurements của mảng bạt) vì C6 hiện từng trục riêng, cỡ tabular.
  measurementLength    Float?  @map("measurement_length")
  measurementDepth     Float?  @map("measurement_depth")
  measurementWidth     Float?  @map("measurement_width")
  measurementThickness Float?  @map("measurement_thickness") // chỉ ghế thấp
  measurementPhoto     String? @map("measurement_photo") // data-URI base64, bắt buộc nếu difficulty=kho (validate ở service)

  hasEmbroidery Boolean @default(false) @map("has_embroidery")
  // [{type:'square',size:'to'|'vua'|'nho',count}|{type:'back',length,width,count}]
  pillows Json?

  dueAt DateTime @map("due_at")

  deliveryMethod DeliveryMethod @default(xe_om) @map("delivery_method")
  routeId        String?        @map("route_id")
  route          Route?         @relation(fields: [routeId], references: [id])

  price   Int @default(0)
  deposit Int @default(0)

  status OrderStatus @default(moi)

  // Nhập tay ở S24 sau khi chốt số cắt — CAP-DEM-03 (công thức gợi ý) đẩy backlog,
  // không có field "gợi ý" riêng vì chưa có gì để gợi ý (DECISIONS.md 2026-09-18).
  fabricMeters Float? @map("fabric_meters")
  foamSheets   Float? @map("foam_sheets")

  createdById String    @map("created_by")
  createdBy   User      @relation("OrderCreatedBy", fields: [createdById], references: [id])
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tasks Task[]

  @@map("orders")
}
