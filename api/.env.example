# PostgreSQL connection string (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_manager

# Secret used to sign JWTs - use a long random value outside local dev
JWT_SECRET=change-me-to-a-long-random-string

# development | production
APP_ENV=development
PORT=3000

# Optional: comma-separated list of browser origins allowed by CORS (mobile app does not need it)
ALLOWED_ORIGINS=

# Optional: Sentry error reporting
SENTRY_DSN=

# Optional: Expo access token for sending push notifications (leave empty to disable auth header)
EXPO_ACCESS_TOKEN=

# Lifetime of a device pairing (QR) code, in minutes
PAIRING_CODE_TTL_MIN=15

# Owner account created by `npm run db:seed` (password is required when APP_ENV=production)
OWNER_SEED_EMAIL=owner@task-manager.local
OWNER_SEED_PASSWORD=change-me
